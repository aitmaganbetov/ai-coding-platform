def latest_plan() -> str:
    """The plan Claude Code wrote in plan mode (2.1.x keeps it in ~/.claude/plans/)."""
    plans = Path.home() / ".claude" / "plans"
    try:
        newest = max(plans.glob("*.md"), key=lambda p: p.stat().st_mtime)
    except (ValueError, OSError):
        return ""
    if time.time() - newest.stat().st_mtime > 3600:
        return ""
    return clip(newest.read_text(encoding="utf-8", errors="replace"), 12000)


async def workspace_state() -> set[str]:
    """`git status` of the workspace with a hash of each changed file's content."""
    try:
        proc = await asyncio.create_subprocess_exec(
            "git", "status", "--porcelain=v1", "-uall", cwd=WORKDIR,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)  # fmt: skip
        out, _ = await asyncio.wait_for(proc.communicate(), 30)
    except (OSError, TimeoutError):
        return set()
    state = set()
    for line in out.decode(errors="replace").splitlines():
        path = Path(WORKDIR) / line[3:].split(" -> ")[-1]
        try:
            digest = hashlib.sha256(path.read_bytes()).hexdigest()[:16] if path.is_file() else "-"
        except OSError:
            digest = "?"
        state.add(f"{line} {digest}")
    return state


def needs_login(text: str) -> bool:
    lower = text.lower()
    return any(hint in lower for hint in LOGIN_HINTS)


