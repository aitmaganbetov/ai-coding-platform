class PlatformError(Exception):
    pass


RUN_ID = {"type": "string", "description": "The run's id (from audit or start_task)."}
PLATFORM_TOOLS: list[dict[str, Any]] = [
    {"name": "info", "description": (
        "The project in the AI Coding Platform: the run kinds your user may start and "
        "whether the orchestrator has an AI provider (start_task needs one). Changes nothing."),
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "audit", "description": (
        "Start the platform's audit: real analysers (Semgrep, Gitleaks, Trivy/OSV, linters, "
        "tests...) in an isolated sandbox, findings with evidence and Quality Gates. source "
        "'workspace' (default) checks the last commit of the current branch of /workspace - "
        "commit first, uncommitted changes are not checked; 'project' checks the project's "
        "own tree. Returns a run id: follow it with run_status, then read run_report. "
        "Changes no file."),
     "inputSchema": {"type": "object", "properties": {
         "source": {"type": "string", "enum": ["workspace", "project"]},
         "tools": {"type": "array", "items": {"type": "string"},
                   "description": "Only these analysers (default: all for the project's stacks)."},
         "strict": {"type": "boolean", "description": "Fail on any finding."}}}},
    {"name": "run_status", "description": (
