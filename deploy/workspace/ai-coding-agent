         "params": {"type": "object"}}, "required": ["kind", "params"]}},
    {"name": "cancel_run", "description": "Cancel a run your user started.",
     "inputSchema": {"type": "object", "properties": {"run_id": RUN_ID}, "required": ["run_id"]}},
]  # fmt: skip
FINISHED = {"COMPLETED", "FAILED", "CANCELLED", "AWAITING_APPROVAL", "PAUSED"}


def platform_call(op: str, payload: dict[str, Any], *, branch: str | None = None,
                  timeout: float = 45.0) -> dict[str, Any]:  # fmt: skip
    """One request through the mailbox; the API answers within a second or two."""
    box = Path(MAILBOX)
    if not box.is_dir():
        raise PlatformError(
            "The platform is not reachable from this workspace (no mailbox at "
            f"{MAILBOX}): it was started before this feature. Ask the user to restart the "
            "environment (the «Перезапустить среду» button)."
        )
    rid = uuid.uuid4().hex
    request, answer = box / f"{rid}.req", box / f"{rid}.res"
    try:
        if branch is not None:
            done = subprocess.run(["git", "bundle", "create", str(box / f"{rid}.bundle"), branch],
                                  cwd=WORKDIR, capture_output=True, text=True, timeout=600)  # fmt: skip
            if done.returncode != 0:
                raise PlatformError(f"git bundle failed: {done.stderr.strip()[-500:]}")
        tmp = box / f".{rid}.tmp"
        tmp.write_text(json.dumps({"op": op, **payload}), encoding="utf-8")
        tmp.replace(request)
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if answer.exists():
                data = json.loads(answer.read_text(encoding="utf-8"))
                return data if isinstance(data, dict) else {"ok": False, "error": "bad answer"}
            time.sleep(0.25)
        raise PlatformError("The platform did not answer in time; try again.")
    finally:
        for path in (request, answer, box / f"{rid}.bundle"):
            with contextlib.suppress(OSError):
                path.unlink()


def git_output(*args: str) -> str:
    done = subprocess.run(["git", *args], cwd=WORKDIR, capture_output=True, text=True, timeout=60)
    return done.stdout if done.returncode == 0 else ""


def platform_tool(name: str, args: dict[str, Any], read_only: bool) -> dict[str, Any]:
    if name == "info":
        return platform_call("info", {})
    if name == "audit":
        source = args.get("source") or "workspace"
        payload = {"source": source, "tools": args.get("tools") or [],
                   "strict": bool(args.get("strict"))}  # fmt: skip
        if source != "workspace":
            return platform_call("audit", payload)
        branch = git_output("symbolic-ref", "--short", "-q", "HEAD").strip()
        if not branch:
            raise PlatformError("/workspace is not on a branch: switch to or create one first.")
        result = platform_call("audit", {**payload, "branch": branch}, branch=branch)
        dirty = git_output("status", "--porcelain").splitlines()
        if dirty and result.get("ok"):
            result["note"] = (f"{len(dirty)} uncommitted change(s) are not part of this audit: "
                              "commit them and audit again to include them.")  # fmt: skip
        return result
    if name == "run_status":
        wait = max(0, min(45, int(args.get("wait_seconds") or 0)))
        deadline = time.monotonic() + wait
        while True:
            result = platform_call("status", {"run_id": args.get("run_id")})
            left = deadline - time.monotonic()
            if (not result.get("ok") or result.get("state") in FINISHED
                    or result.get("pending_approvals") or left <= 0):  # fmt: skip
                return result
            time.sleep(min(3.0, left))
    if name == "run_report":
        return platform_call("report", {"run_id": args.get("run_id")})
    if name in ("start_task", "cancel_run") and read_only:
        raise PlatformError("This chat is in AUDIT mode (read-only): no tasks, no cancellations.")
    if name == "start_task":
        return platform_call("start_task", {"kind": args.get("kind"), "params": args.get("params")})
    if name == "cancel_run":
        return platform_call("cancel", {"run_id": args.get("run_id")})
    raise PlatformError(f"unknown tool {name!r}")


def mcp(argv: list[str]) -> int:
    """The `platform` MCP server (stdio, newline-delimited JSON-RPC 2.0)."""
    read_only = "--read-only" in argv
    tools = [t for t in PLATFORM_TOOLS if not read_only or t["name"] in PLATFORM_READ_TOOLS]
    for tool in tools:
        read = tool["name"] in PLATFORM_READ_TOOLS
        tool["annotations"] = {"readOnlyHint": read, "destructiveHint": False,
                               "openWorldHint": False}  # fmt: skip
    for raw in sys.stdin.buffer:
        try:
            msg = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(msg, dict) or msg.get("id") is None:
            continue  # notifications (initialized, cancelled...)
        method, params = msg.get("method"), msg.get("params") or {}
        reply: dict[str, Any] = {"jsonrpc": "2.0", "id": msg["id"]}
        if method == "initialize":
            reply["result"] = {
                "protocolVersion": params.get("protocolVersion") or "2025-06-18",
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": {"name": "ai-coding-platform", "version": "1.0"},
                "instructions": PLATFORM_RULES}  # fmt: skip
        elif method == "ping":
            reply["result"] = {}
        elif method == "tools/list":
            reply["result"] = {"tools": tools}
        elif method == "tools/call":
            name = str(params.get("name"))
            args = params.get("arguments") if isinstance(params.get("arguments"), dict) else {}
            try:
                if name not in {t["name"] for t in tools}:
                    raise PlatformError(f"unknown tool {name!r}")
                result = platform_tool(name, args, read_only)
                ok = bool(result.pop("ok", False))
                text = (json.dumps(result, ensure_ascii=False, indent=1) if ok
                        else f"Platform error: {result.get('error')}")  # fmt: skip
            except PlatformError as exc:
                ok, text = False, str(exc)
            except Exception as exc:  # noqa: BLE001 - the agent gets the error as a result
                ok, text = False, f"{type(exc).__name__}: {exc}"
            reply["result"] = {"content": [{"type": "text", "text": text}], "isError": not ok}
        else:
            reply["error"] = {"code": -32601, "message": f"method not found: {method}"}
        sys.stdout.write(json.dumps(reply, ensure_ascii=False) + "\n")
        sys.stdout.flush()
    return 0


# --------------------------------------------------------------- commands --
def alive() -> bool:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
        try:
            probe.connect(SOCKET)
        except OSError:
            return False
        return True


async def serve() -> None:
    import fcntl  # noqa: PLC0415 - POSIX only, like the container

    lock = open(SOCKET + ".lock", "w")  # noqa: SIM115 - held for the daemon's lifetime
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another daemon is starting or running
    if alive():
        return
    with contextlib.suppress(FileNotFoundError):
        os.unlink(SOCKET)
    hub = Hub()
    server = await asyncio.start_unix_server(hub.handle, path=SOCKET, limit=LINE_LIMIT)
    os.chmod(SOCKET, 0o600)
    async with server:
        await server.serve_forever()


def connect() -> int:
    """Relay stdin/stdout to the daemon (the broker's ``docker exec -i`` uses this)."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    for _ in range(50):
        try:
            sock.connect(SOCKET)
            break
        except OSError:
            time.sleep(0.1)
    else:
        print(json.dumps({"t": "error", "message": "the agent daemon is not running"}), flush=True)
        return 1

    def upstream() -> None:
        with contextlib.suppress(OSError):
            for chunk in iter(lambda: sys.stdin.buffer.read1(65536), b""):
                sock.sendall(chunk)
        with contextlib.suppress(OSError):
            sock.shutdown(socket.SHUT_WR)

    threading.Thread(target=upstream, daemon=True).start()
    with contextlib.suppress(OSError):
        while chunk := sock.recv(65536):
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
    return 0


def status() -> int:
    if not alive():
        print(json.dumps({"t": "status", "busy": False, "clients": 0, "running": False}))
        return 0
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.connect(SOCKET)
        sock.sendall(b'{"op": "status"}\n')
        data = b""
        while b"\n" not in data and (chunk := sock.recv(4096)):
            data += chunk
    print(data.decode().strip())
    return 0


def main(argv: list[str]) -> int:
    command = argv[1] if len(argv) > 1 else ""
    if command == "serve":
        asyncio.run(serve())
        return 0
    if command == "connect":
        return connect()
    if command == "status":
        return status()
    if command == "mcp":
        return mcp(argv[2:])
    print("usage: ai-coding-agent serve|connect|status|mcp", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
