def clip(text: Any, limit: int = OUTPUT_LIMIT) -> str:
    text = "" if text is None else str(text)
    return text if len(text) <= limit else text[:limit] + f"\n… (+{len(text) - limit} символов)"


def rel(path: Any) -> str:
    text = str(path or "")
    return text[len(WORKDIR) + 1 :] if text.startswith(WORKDIR + "/") else text


# ---------------------------------------------------------- read-only commands --
# AUDIT reads only. Claude Code's read tools work without a question; a shell command (both
# agents read files with them) is let through when this conservative check proves that it
# only reads: known reading programs, without writing options, substitutions, background
# jobs or redirections other than to /dev/null. Anything else is refused, as before.
READ_TOOLS = ("Read", "Grep", "Glob", "LS", "NotebookRead", "Task", "Agent", "TodoWrite")
READ_PROGRAMS = {
    "cat", "head", "tail", "ls", "tree", "find", "grep", "egrep", "fgrep", "rg", "wc",
    "sort", "uniq", "cut", "tr", "nl", "file", "stat", "du", "df", "pwd", "echo", "printf",
    "diff", "cmp", "comm", "basename", "dirname", "realpath", "readlink", "sed", "jq",
    "column", "md5sum", "sha1sum", "sha256sum", "true", "test", "cd", "date", "id",
    "whoami", "uname", "which", "git", "xargs",
}  # fmt: skip
GIT_READ = {"status", "log", "diff", "show", "blame", "ls-files", "ls-tree", "grep",
            "rev-parse", "describe", "shortlog", "cat-file", "branch", "tag", "reflog"}  # fmt: skip
FIND_WRITES = {"-exec", "-execdir", "-ok", "-okdir", "-delete", "-fprint", "-fprint0",
               "-fprintf", "-fls"}  # fmt: skip
SED_SCRIPT = re.compile(r"^(?:(?:\d+|\$|/[^/]*/)(?:,(?:\d+|\$|/[^/]*/))?)?[pq=]$")
OPERATORS = {"|", "||", "&&", ";"}
SHELLS = {"bash", "sh", "zsh"}


def read_only_command(command: str) -> bool:
    """Whether a shell command certainly only reads (see READ_PROGRAMS)."""
    if any(s in command for s in ("\n", "\r", "$(", "${", "`", "<(", ">(")):
        return False
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
        lexer.whitespace_split = True
        tokens = list(lexer)
    except ValueError:
        return False
    if len(tokens) == 3 and tokens[0] in SHELLS and tokens[1] in ("-c", "-lc"):
        return read_only_command(tokens[2])  # Codex runs commands as `bash -lc '...'`
    commands: list[list[str]] = [[]]
    index = 0
    while index < len(tokens):
        token = tokens[index]
        if token in OPERATORS:
            commands.append([])
        elif token in (">", ">>", ">|", "&>"):
            target = tokens[index + 1] if index + 1 < len(tokens) else ""
            if target != "/dev/null":
                return False
            if commands[-1] and commands[-1][-1].isdigit():
                commands[-1].pop()  # the descriptor of 2>/dev/null
            index += 1
        elif token == ">&":
            target = tokens[index + 1] if index + 1 < len(tokens) else ""
            if not target.isdigit():
                return False
            if commands[-1] and commands[-1][-1].isdigit():
                commands[-1].pop()
            index += 1
        elif token == "<":
            index += 1  # reading a file is reading
        elif set(token) <= set("|&;<>()"):
            return False  # "&" (background) and anything unusual
        else:
            commands[-1].append(token)
        index += 1
    return all(command and _reads(command) for command in commands)


def _reads(argv: list[str]) -> bool:
    program, args = os.path.basename(argv[0]), argv[1:]
    if program not in READ_PROGRAMS or "=" in argv[0]:
        return False
    if program == "find":
        return not FIND_WRITES & set(args)
    if program == "sed":
        if any(a.startswith(("-i", "--in-place")) or a in ("-f", "--file") for a in args):
            return False
        scripts = [a for a in args if not a.startswith("-")][:1] if "-e" not in args else \
            [args[i + 1] for i, a in enumerate(args[:-1]) if a == "-e"]  # fmt: skip
        return bool(scripts) and all(SED_SCRIPT.match(s.strip()) for s in scripts)
    if program == "rg":
        return not any(a.startswith(("--pre", "--search-zip", "-z")) for a in args)
    if program in ("sort", "tree"):
        return not any(a.startswith(("-o", "--output")) for a in args)
    if program == "uniq":
        return len([a for a in args if not a.startswith("-")]) <= 1  # uniq IN OUT writes
    if program == "git":
        if not args or args[0] not in GIT_READ:
            return False  # also refuses global options such as -c (config, pager)
        if any(a.startswith(("--output", "--ext-diff", "-o")) for a in args):
            return False
        if args[0] in ("branch", "tag"):  # listing only
            return all(a.startswith("-") and a not in ("-d", "-D", "-m", "-M", "-c", "-C", "-f",
                                                       "--delete", "--move", "--copy", "--force")
                       for a in args[1:])  # fmt: skip
        return True
    if program == "xargs":
        rest = list(args)
        while rest and rest[0].startswith("-"):
            option = rest.pop(0)
            if option in ("-n", "-I", "-d", "-P", "-L", "-s", "-E") and rest:
                rest.pop(0)
        return bool(rest) and rest[0] != "xargs" and _reads(rest)
    return True


def workflow(meta: dict[str, Any]) -> dict[str, Any] | None:
    return WORKFLOWS.get(str(meta.get("workflow")))


def system_prompt(meta: dict[str, Any]) -> str:
    """Language rule, then the chat's platform mode (chats made before modes have none)."""
    mode = workflow(meta)
    parts = [LANGUAGE_PROMPT, PLATFORM_RULES]
    if mode is not None:
        parts += [COMMON_RULES, mode["prompt"]]
    return "\n\n".join(parts)


def mcp_server(read_only: bool) -> dict[str, Any]:
    """The `platform` MCP server, as both CLIs configure one (stdio)."""
