# Copy to deploy/.env (never commit it) and fill in. See docs/server.md.
AI_CODING_DOMAIN=ai-coding.example.org
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Optional: a separate secret for the Prometheus scraper.
AI_CODING_SERVER_METRICS_TOKEN=
# Retention of finished runs in days (0 = only the per-project setting via `server purge`).
AI_CODING_SERVER_RETENTION_DAYS=0
# Concurrent runs per worker container (NFR-02: >= 10).
AI_CODING_SERVER_WORKERS=10
# Host directory shared by the worker and the sandboxes it starts (same path inside and out).
AI_CODING_DATA=/srv/ai-coding
# Signs the API's requests to the workspace service (browser terminals): openssl rand -hex 32
AI_CODING_SERVER_WORKSPACE_SECRET=

# Encrypts projects' secrets (GitHub tokens, AI keys, webhook keys): openssl rand -hex 32
AI_CODING_SERVER_SECRET_KEY=

# AI Security Center, read-only (docs/security-center.md): off by default; on only after
# the staging check described there.
AI_CODING_SERVER_SECURITY_CENTER=off
