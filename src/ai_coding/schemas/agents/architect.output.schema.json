{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding.dev/schemas/agents/architect.output.schema.json",
  "title": "Architect Agent output: ADRs, module structure, API and data model",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "enum": [
            "python",
            "javascript",
            "typescript",
            "php",
            "go",
            "rust",
            "java",
            "other"
          ]
        },
        "framework": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "language",
        "framework",
        "database"
      ]
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "responsibility": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,39}$"
            },
            "minItems": 0,
            "maxItems": 20
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FR-[0-9]{2,3}$"
            },
            "minItems": 0,
            "maxItems": 50
          }
        },
        "required": [
          "name",
          "responsibility",
          "depends_on",
          "requirement_refs"
        ]
      },
      "minItems": 1,
      "maxItems": 40
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ADR-[0-9]{4}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "decision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "consequences": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "minItems": 0,
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "title",
          "context",
          "decision",
          "consequences",
          "alternatives"
        ]
      },
      "minItems": 1,
      "maxItems": 30
    },
    "api": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "CLI",
              "EVENT"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          }
        },
        "required": [
          "method",
          "path",
          "summary",
          "module"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "data_model": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "type",
                "required"
              ]
            },
            "minItems": 1,
            "maxItems": 60
          }
        },
        "required": [
          "entity",
          "description",
          "fields"
        ]
      },
      "minItems": 0,
      "maxItems": 60
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Self-assessed confidence; informative only, never replaces checks."
    }
  },
  "required": [
    "stack",
    "modules",
    "adrs",
    "api",
    "data_model"
  ]
}
