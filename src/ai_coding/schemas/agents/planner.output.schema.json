{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding.dev/schemas/agents/planner.output.schema.json",
  "title": "Planner Agent output: backlog with dependencies and estimates",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "type": {
            "enum": [
              "feature",
              "chore",
              "test",
              "docs",
              "infra"
            ]
          },
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FR-[0-9]{2,3}$"
            },
            "minItems": 0,
            "maxItems": 20
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T-[0-9]{3}$"
            },
            "minItems": 0,
            "maxItems": 20
          },
          "estimate_points": {
            "enum": [
              1,
              2,
              3,
              5,
              8,
              13
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "type",
          "module",
          "requirement_refs",
          "depends_on",
          "estimate_points",
          "priority",
          "acceptance"
        ]
      },
      "minItems": 1,
      "maxItems": 200
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T-[0-9]{3}$"
            },
            "minItems": 1,
            "maxItems": 200
          }
        },
        "required": [
          "name",
          "goal",
          "items"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Self-assessed confidence; informative only, never replaces checks."
    }
  },
  "required": [
    "items",
    "milestones"
  ]
}
