{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding.dev/schemas/agents/security.output.schema.json",
  "title": "Security Agent output: triaged vulnerabilities with evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "verdict": {
            "enum": [
              "confirmed",
              "false_positive",
              "needs_review"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "exploit_scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "cwe": {
            "type": "string",
            "pattern": "^CWE-[0-9]{1,5}$"
          }
        },
        "required": [
          "finding_id",
          "verdict",
          "severity",
          "evidence",
          "recommendation"
        ]
      },
      "minItems": 0,
      "maxItems": 500
    },
    "additional_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?![/\\\\])(?!.*(^|/)\\.\\.(/|$))[^\\\\:*?\"<>|]+$"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "file",
          "severity",
          "message",
          "recommendation"
        ]
      },
      "minItems": 0,
      "maxItems": 50
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Self-assessed confidence; informative only, never replaces checks."
    }
  },
  "required": [
    "summary",
    "assessments",
    "additional_risks"
  ]
}
