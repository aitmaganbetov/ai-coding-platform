{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding.dev/schemas/agents/planner.migration.output.schema.json",
  "title": "Planner Agent (MODERNIZE) output: impact analysis and stepwise migration plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "baseline_assessment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?![/\\\\])(?!.*(^|/)\\.\\.(/|$))[^\\\\:*?\"<>|]+$"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 0,
          "maxItems": 50
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "risk": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "mitigation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "risk",
              "mitigation"
            ]
          },
          "minItems": 0,
          "maxItems": 30
        }
      },
      "required": [
        "files",
        "modules",
        "risks"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^M-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^(?![/\\\\])(?!.*(^|/)\\.\\.(/|$))[^\\\\:*?\"<>|]+$"
            },
            "minItems": 0,
            "maxItems": 50
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "rollback": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "files",
          "verification",
          "rollback",
          "risk"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "rollback_strategy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Self-assessed confidence; informative only, never replaces checks."
    }
  },
  "required": [
    "goal",
    "baseline_assessment",
    "impact",
    "steps",
    "rollback_strategy"
  ]
}
