#!/usr/bin/env python3
"""Fake Claude Code CLI for the chat daemon tests: the stream-json protocol of 2.1.x.

`claude auth status --json` -> logged in with an API key. `claude -p …` reads user messages:
* "write …" -> a Write tool call that needs permission (control_request can_use_tool);
* "slow …"  -> waits for an interrupt control_request, then ends the turn as interrupted;
* "plan …"  -> plan mode's ExitPlanMode (2.1.x: the plan is in ~/.claude/plans/, input {});
* "sneak …" -> writes sneaky.txt without asking (as a rule in the user's settings would allow);
* "read …"  -> a Bash command that only reads, then Read outside the workspace (both asked);
* anything else -> a text answer.
With FAKE_CLI_LOG set, the arguments, mode switches and permission answers are appended
there as JSON lines, for the tests to check.
"""
import json
import os
import sys
import uuid

args = sys.argv[1:]
if args[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": True, "authMethod": "api_key"}))
    sys.exit(0)
session = args[args.index("--session-id") + 1] if "--session-id" in args else args[args.index("--resume") + 1]
assert "language of the user's most recent message" in args[args.index("--append-system-prompt") + 1]


def log(**entry):
    if os.environ.get("FAKE_CLI_LOG"):
        with open(os.environ["FAKE_CLI_LOG"], "a") as fh:
            fh.write(json.dumps({"cli": "claude", **entry}) + "\n")


log(args=args)


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def read():
    line = sys.stdin.readline()
    return json.loads(line) if line else None


out({"type": "system", "subtype": "init", "session_id": session, "model": "claude-fake"})
while True:
    msg = read()
    if msg is None:
        break
    if msg.get("type") == "control_request" and msg["request"]["subtype"] == "set_permission_mode":
        log(set_mode=msg["request"]["mode"])
        out({"type": "control_response", "response": {"subtype": "success",
                                                      "request_id": msg["request_id"]}})
        continue
    if msg.get("type") != "user":
        continue
    text = msg["message"]["content"][0]["text"]
    mid = "msg_" + uuid.uuid4().hex[:6]
    if text.startswith("write"):
        out({"type": "assistant", "message": {"id": mid, "content": [
            {"type": "tool_use", "id": "toolu_1", "name": "Write",
             "input": {"file_path": os.getcwd() + "/hello.txt", "content": "hello\n"}}]}})
        out({"type": "control_request", "request_id": "req-1", "request": {
            "subtype": "can_use_tool", "tool_name": "Write",
            "input": {"file_path": os.getcwd() + "/hello.txt", "content": "hello\n"},
            "permission_suggestions": [{"type": "setMode", "mode": "acceptEdits"}],
            "tool_use_id": "toolu_1"}})
        reply = read()
        allowed = reply["response"]["response"]["behavior"] == "allow"
        if allowed:
            with open("hello.txt", "w") as fh:
                fh.write("hello\n")
        out({"type": "user", "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "toolu_1", "is_error": not allowed,
             "content": "File created" if allowed else "denied"}]},
            "tool_use_result": {"type": "create", "filePath": os.getcwd() + "/hello.txt",
                                "content": "hello\n", "structuredPatch": []} if allowed else "denied"})
        out({"type": "assistant", "message": {"id": mid + "b", "content": [
            {"type": "text", "text": "Записал файл." if allowed else "Не записал."}]}})
        out({"type": "result", "is_error": False, "total_cost_usd": 0.01, "duration_ms": 5,
             "session_id": session})
    elif text.startswith("plan"):
        plans = os.path.join(os.environ["HOME"], ".claude", "plans")
        os.makedirs(plans, exist_ok=True)
        with open(os.path.join(plans, "fake-plan.md"), "w") as fh:
            fh.write("# План\n1. Добавить hello.txt\n2. Проверить\n")
        out({"type": "assistant", "message": {"id": mid, "content": [
            {"type": "tool_use", "id": "toolu_p", "name": "ExitPlanMode", "input": {}}]}})
        out({"type": "control_request", "request_id": "req-p", "request": {
            "subtype": "can_use_tool", "tool_name": "ExitPlanMode", "input": {},
            "tool_use_id": "toolu_p"}})
        reply = read()["response"]["response"]
        log(answer=reply)
        allowed = reply["behavior"] == "allow"
        if allowed:
            modes = [u["mode"] for u in reply.get("updatedPermissions") or [] if u["type"] == "setMode"]
            out({"type": "system", "subtype": "status", "permissionMode": (modes or ["default"])[-1],
                 "session_id": session})
        out({"type": "user", "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "toolu_p", "is_error": not allowed,
             "content": "approved" if allowed else reply["message"]}]}})
        out({"type": "assistant", "message": {"id": mid + "b", "content": [
            {"type": "text", "text": "Выполняю план." if allowed else "Жду правок."}]}})
        out({"type": "result", "is_error": False, "total_cost_usd": 0.0, "duration_ms": 3,
             "session_id": session})
    elif text.startswith("read"):
        for n, (tool, data) in enumerate((("Bash", {"command": "sed -n '1,5p' notes.txt | head"}),
                                          ("Read", {"file_path": "/project/README.md"}))):
            out({"type": "control_request", "request_id": f"req-r{n}", "request": {
                "subtype": "can_use_tool", "tool_name": tool, "input": data,
                "tool_use_id": f"toolu_r{n}"}})
            log(answer=read()["response"]["response"])
        out({"type": "result", "is_error": False, "total_cost_usd": 0.0, "duration_ms": 1,
             "session_id": session})
    elif text.startswith("sneak"):
        with open("sneaky.txt", "w") as fh:
            fh.write("changed\n")
        out({"type": "assistant", "message": {"id": mid, "content": [
            {"type": "text", "text": "Проверил."}]}})
        out({"type": "result", "is_error": False, "total_cost_usd": 0.0, "duration_ms": 1,
             "session_id": session})
    elif text.startswith("slow"):
        out({"type": "stream_event", "api_message_id": mid, "event": {
            "type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "Думаю"}}})
        while (control := read()) is not None:
            if control.get("type") == "control_request" and control["request"]["subtype"] == "interrupt":
                out({"type": "result", "is_error": True, "result": "interrupted", "session_id": session})
                break
    else:
        out({"type": "stream_event", "api_message_id": mid, "event": {
            "type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "При"}}})
        out({"type": "assistant", "message": {"id": mid, "content": [
            {"type": "text", "text": f"Привет! ({'resumed' if '--resume' in args else 'new'})"}]}})
        out({"type": "result", "is_error": False, "total_cost_usd": 0.0, "duration_ms": 1,
             "session_id": session})
